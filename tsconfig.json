{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sdk/shared": ["packages/shared/src"],
      "@sdk/admin": ["packages/admin/src"],
      "@sdk/service": ["packages/service/src"],
      "@sdk/heatmap": ["packages/heatmap/src"],
      "@sdk/aoilayer": ["packages/aoilayer/src"]
    }
  },
  "include": ["src", "packages", "examples", "tests", "rollup.config.ts"]
}
