{
  "name": "sfmap-sdk3-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Rollup-based Mapbox GL JS plugin SDK monorepo",
  "packageManager": "pnpm@9.12.0",
  "main": "dist/sdk.umd.js",
  "module": "dist/sdk.esm.js",
  "unpkg": "dist/sdk.umd.js",
  "exports": {
    ".": {
      "import": "./dist/sdk.esm.js",
      "require": "./dist/sdk.umd.js"
    },
    "./admin": {
      "import": "./dist/admin.esm.js",
      "require": "./dist/admin.umd.js"
    },
    "./service": {
      "import": "./dist/service.esm.js",
      "require": "./dist/service.umd.js"
    },
    "./heatmap": {
      "import": "./dist/heatmap.esm.js",
      "require": "./dist/heatmap.umd.js"
    },
    "./aoilayer": {
      "import": "./dist/aoilayer.esm.js",
      "require": "./dist/aoilayer.umd.js"
    },
    "./shared": {
      "import": "./dist/shared.esm.js",
      "require": "./dist/shared.umd.js"
    }
  },
  "scripts": {
    "dev": "pnpm run prepare:modules && vite --config examples/vite.config.js",
    "doc": "vitepress dev . --port 8080",
    "build": "pnpm run prepare:modules && pnpm run build:lib && pnpm run build:docs",
    "build:lib": "pnpm run prepare:modules && rimraf dist && rollup -c",
    "build:docs": "vitepress build .",
    "test": "pnpm run prepare:modules && vitest run",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "release": "pnpm run lint && pnpm run test && pnpm run build:lib && pnpm changeset version && echo 'Ready to publish (simulation)'",
    "prepare:modules": "node scripts/generate-modules.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.26.0",
    "vite": "^5.4.10",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@turf/bbox": "^6.5.0",
    "@turf/turf": "^6.5.0",
    "crypto-js": "^4.1.1",
    "jsencrypt": "3.2.1",
    "@terraformer/wkt": "^2.2.0",
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "proj4": "^2.20.2"
  }
}
